{
  "name": "crypto-trade-bot",
  "version": "1.0.0",
  "description": "KriptoKaptan — Telegram üzerinden çalışan, NestJS tabanlı Binance Futures trading asistanı (trading beyni)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest --runInBand",
    "smoke": "ts-node scripts/market-smoke.ts",
    "smoke:e2e": "ts-node scripts/e2e-simulate.ts",
    "smoke:brain": "ts-node scripts/real-brain-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "grammy": "^1.36.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "moduleFileExtensions": [
      "js",
      "ts",
      "json"
    ],
    "testTimeout": 20000
  }
}
