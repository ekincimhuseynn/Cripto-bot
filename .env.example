# =====================================================================
#  KriptoKaptan — Trading Asistanı Botu | Ortam Değişkenleri
#  Bu dosyayı .env olarak kopyala ve değerlerini doldur:  cp .env.example .env
# =====================================================================

# ------------------------- TELEGRAM ---------------------------------
# BotFather'dan aldığın bot token (zorunlu)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Botun cevap vereceği Telegram chat ID'leri (virgülle ayır).
# Kendi ID'ni öğrenmek için: @userinfobot
# BOŞ bırakırsan bot HERKESE açık olur (önerilmez!)
TELEGRAM_CHAT_ID=111111111

# ---------------------- KARAR MODELİ (LLM) ---------------------------
# openai | anthropic | gemini
# ÜCRETSİZ seçenek: gemini (aistudio.google.com → Get API key; kredi kartı gerekmez)
LLM_PROVIDER=openai

# Seçtiğin sağlayıcının API anahtarı
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# OpenAI-uyumlu ALTERNATİF uç nokta (opsiyonel):
#   Groq:      LLM_PROVIDER=openai + LLM_BASE_URL=https://api.groq.com/openai/v1 + LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_PROVIDER=openai + LLM_BASE_URL=https://openrouter.ai/api/v1  + LLM_MODEL=<model>
LLM_BASE_URL=

# Modeller (boş bırakırsan aşağıdaki varsayılanlar kullanılır)
# Varsayılanlar: openai=gpt-4o | anthropic=claude-sonnet-4-5 | gemini=gemini-3.8-flash
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.4

# ---------------------- SERMAYE & RİSK KURALLARI ----------------------
# Başlangıç bütçen (USDT)
START_BALANCE=1000

# KILL SWITCH eşiği: bakiye bu değerin ALTINA düşerse tüm işlemler durur
KILL_SWITCH_THRESHOLD=700

# Bir pozisyona ayrılabilecek maksimum margin (bakiyenin yüzdesi) — DEĞİŞMEZ KURAL: %50
MAX_MARGIN_PCT=50

# Maksimum kaldıraç — DEĞİŞMEZ KURAL: 10
MAX_LEVERAGE=10

# Bu güven skorunun altındaki öneriler asla kart olarak sunulmaz
MIN_CONFIDENCE=6

# ------------------------- OTOMATİK NÖBET -----------------------------
# Cron formatı (varsayılan: her 10 dakikada bir)
PATROL_CRON=*/10 * * * *
PATROL_ENABLED=true

# Aynı fırsatın (aynı coin + aynı yön) tekrar gönderilmeme süresi (saat)
PATROL_DEDUPE_HOURS=6

# Aynı coin için iki uyarı arasındaki minimum süre (dakika)
PATROL_ALERT_COOLDOWN_MIN=60

# Nöbette kart göndermek için gereken minimum güven skoru
PATROL_MIN_CONFIDENCE=7

# Sert hareket eşikleri (uyarı tetikler)
ALERT_1H_PCT=2.5
ALERT_15M_PCT=1.8
ALERT_24H_PCT=10

# --------------------------- TARAMA -----------------------------------
# Detaylı teknik analiz yapılacak coin sayısı (en hacimliler + en çok hareket edenler)
SCAN_SHORTLIST=10

# ------------------------- VERİ KAYNAKLARI -----------------------------
# Öncelik sırası (virgülle ayır). İlk erişilebilen kullanılır.
# BINANCE_FUTURES | OKX | BYBIT | BINANCE_VISION
DATA_SOURCE_PRIORITY=BINANCE_FUTURES,OKX,BYBIT,BINANCE_VISION

# --------------------------- VERİTABANI --------------------------------
DB_PATH=data/bot.sqlite

# ----------------------------- SUNUCU ----------------------------------
PORT=3000
LOG_LEVEL=info
